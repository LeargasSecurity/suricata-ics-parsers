[package]
name = "suricata-ics-parsers"
version = "0.2.1"
edition = "2021"
authors = ["Leargas Security"]
description = "Suricata S7comm/S7comm-plus, IEC 60870-5-104 and MMS/IEC 61850/ICCP ICS protocol parser plugin"
license = "GPL-2.0"

[lib]
name = "suricata_ics"
crate-type = ["cdylib", "rlib"]

[dependencies]
nom7 = { version = "7.0", package = "nom" }
libc = "~0.2.82"
# ASN.1 BER decoding for MMS; same version as Suricata 8.0.x so the crate is shared.
der-parser = { version = "~9.0.0", default-features = false }
# These paths are filled in from $SURICATA_SRC by `make configure`.
# Do not edit the generated Cargo.toml directly; edit Cargo.toml.in instead.
suricata = { path = "@SURICATA_RUST@" }
suricata-sys = { path = "@SURICATA_RUST@/sys" }

[features]
default = ["suricata8"]
suricata8 = []

[lints.rust]
# cargo-fuzz builds with --cfg fuzzing (see src/fuzz_api.rs).
unexpected_cfgs = { level = "warn", check-cfg = ["cfg(fuzzing)"] }
