#
# These rules require the suricata-s7comm app-layer parser plugin.
# Keywords: s7comm.function_code, s7comm.rosctr, s7comm.dangerous,
#           s7comm.userdata_group, s7comm.subfunction, s7comm.plus

# ============================================================================
# ATT&CK ICS: T0858 Change Operating Mode / T0814 Denial of Service
# ============================================================================

alert s7comm any any -> any 102 (msg:"S7COMM PLC Stop Command"; \
    s7comm.function_code:0x29; s7comm.rosctr:1; \
    classtype:attempted-dos; \
    metadata:attack_target ICS, mitre_attack_technique T0858, mitre_attack_technique T0814; \
    sid:3700001; rev:1;)

alert s7comm any any -> any 102 (msg:"S7COMM PLC Control (Mode Change)"; \
    s7comm.function_code:0x28; s7comm.rosctr:1; \
    classtype:attempted-admin; \
    metadata:attack_target ICS, mitre_attack_technique T0858; \
    sid:3700002; rev:1;)

# ============================================================================
# ATT&CK ICS: T0843 Program Download
# ============================================================================

alert s7comm any any -> any 102 (msg:"S7COMM Request Download (Program Transfer)"; \
    s7comm.function_code:0x1a; s7comm.rosctr:1; \
    classtype:attempted-admin; \
    metadata:attack_target ICS, mitre_attack_technique T0843; \
    sid:3700003; rev:1;)

alert s7comm any any -> any 102 (msg:"S7COMM Download Block"; \
    s7comm.function_code:0x1b; s7comm.rosctr:1; \
    classtype:attempted-admin; \
    metadata:attack_target ICS, mitre_attack_technique T0843; \
    sid:3700004; rev:1;)

alert s7comm any any -> any 102 (msg:"S7COMM Download Ended"; \
    s7comm.function_code:0x1c; s7comm.rosctr:1; \
    classtype:attempted-admin; \
    metadata:attack_target ICS, mitre_attack_technique T0843; \
    sid:3700005; rev:1;)

# ============================================================================
# ATT&CK ICS: T0845 Program Upload
# ============================================================================

alert s7comm any any -> any 102 (msg:"S7COMM Start Upload (Program Exfiltration)"; \
    s7comm.function_code:0x1d; s7comm.rosctr:1; \
    classtype:attempted-admin; \
    metadata:attack_target ICS, mitre_attack_technique T0845; \
    sid:3700006; rev:1;)

alert s7comm any any -> any 102 (msg:"S7COMM Upload Block"; \
    s7comm.function_code:0x1e; s7comm.rosctr:1; \
    classtype:attempted-admin; \
    metadata:attack_target ICS, mitre_attack_technique T0845; \
    sid:3700007; rev:1;)

alert s7comm any any -> any 102 (msg:"S7COMM End Upload"; \
    s7comm.function_code:0x1f; s7comm.rosctr:1; \
    classtype:attempted-admin; \
    metadata:attack_target ICS, mitre_attack_technique T0845; \
    sid:3700008; rev:1;)

# ============================================================================
# ATT&CK ICS: T0836 Modify Parameter
# ============================================================================

alert s7comm any any -> any 102 (msg:"S7COMM Write Variable"; \
    s7comm.function_code:0x05; s7comm.rosctr:1; \
    classtype:attempted-admin; \
    metadata:attack_target ICS, mitre_attack_technique T0836; \
    sid:3700009; rev:1;)

# ============================================================================
# ATT&CK ICS: T0886 Remote Services
# ============================================================================

alert s7comm any any -> any 102 (msg:"S7COMM Setup Communication (New Session)"; \
    s7comm.function_code:0xf0; s7comm.rosctr:1; \
    classtype:protocol-command-decode; \
    metadata:attack_target ICS, mitre_attack_technique T0886; \
    sid:3700010; rev:1;)

# ============================================================================
# Catch-all for any dangerous operation
# ============================================================================

alert s7comm any any -> any 102 (msg:"S7COMM Dangerous Operation Detected"; \
    s7comm.dangerous; s7comm.rosctr:1; \
    classtype:attempted-admin; \
    metadata:attack_target ICS; \
    sid:3700099; rev:1;)

# ============================================================================
# S7comm-plus detection (newer Siemens PLCs - S7-1200/1500)
# ============================================================================

alert s7comm any any -> any 102 (msg:"S7COMM-Plus Protocol Detected"; \
    s7comm.plus; \
    classtype:protocol-command-decode; \
    metadata:attack_target ICS; \
    sid:3700100; rev:1;)

# ============================================================================
# Userdata function groups (diagnostics, programmer access)
# ============================================================================

alert s7comm any any -> any 102 (msg:"S7COMM Programmer Commands (Userdata)"; \
    s7comm.rosctr:7; s7comm.userdata_group:1; \
    classtype:attempted-admin; \
    metadata:attack_target ICS, mitre_attack_technique T0843; \
    sid:3700101; rev:1;)

alert s7comm any any -> any 102 (msg:"S7COMM Security Function Access"; \
    s7comm.rosctr:7; s7comm.userdata_group:5; \
    classtype:attempted-admin; \
    metadata:attack_target ICS, mitre_attack_technique T0859; \
    sid:3700102; rev:1;)

# ============================================================================
# Reconnaissance: Read SZL (System Status List) enumeration
# ATT&CK ICS: T0888 Remote System Information Discovery
# ============================================================================

alert s7comm any any -> any 102 (msg:"S7COMM Read SZL (System Enumeration)"; \
    s7comm.rosctr:7; s7comm.userdata_group:4; s7comm.subfunction:1; \
    classtype:attempted-recon; \
    metadata:attack_target ICS, mitre_attack_technique T0888; \
    sid:3700103; rev:1;)

# ============================================================================
# Data-block-aware Read/Write detection (uses parsed item addressing)
# ATT&CK ICS: T0836 Modify Parameter
# ============================================================================

alert s7comm any any -> any 102 (msg:"S7COMM Write to Data Block"; \
    s7comm.function_code:0x05; s7comm.area:0x84; \
    classtype:attempted-admin; \
    metadata:attack_target ICS, mitre_attack_technique T0836; \
    sid:3700104; rev:1;)

alert s7comm any any -> any 102 (msg:"S7COMM Write to Output Area (Process Manipulation)"; \
    s7comm.function_code:0x05; s7comm.area:0x82; \
    classtype:attempted-admin; \
    metadata:attack_target ICS, mitre_attack_technique T0836, mitre_attack_technique T0831; \
    sid:3700105; rev:1;)

alert s7comm any any -> any 102 (msg:"S7COMM Write to Flags/Merker Area"; \
    s7comm.function_code:0x05; s7comm.area:0x83; \
    classtype:attempted-admin; \
    metadata:attack_target ICS, mitre_attack_technique T0836; \
    sid:3700106; rev:1;)

# Example: alert on any write to a specific critical data block (DB100)
alert s7comm any any -> any 102 (msg:"S7COMM Write to Critical DB100"; \
    s7comm.function_code:0x05; s7comm.db:100; \
    classtype:attempted-admin; \
    metadata:attack_target ICS, mitre_attack_technique T0836; \
    sid:3700107; rev:1;)

# ============================================================================
# S7comm-plus (S7-1200/1500) function-level detection
# ============================================================================

alert s7comm any any -> any 102 (msg:"S7COMM-Plus SetVariable (Write)"; \
    s7comm.plus_function:0x04f2; \
    classtype:attempted-admin; \
    metadata:attack_target ICS, mitre_attack_technique T0836; \
    sid:3700108; rev:1;)

alert s7comm any any -> any 102 (msg:"S7COMM-Plus Explore (Enumeration)"; \
    s7comm.plus_function:0x04b1; \
    classtype:attempted-recon; \
    metadata:attack_target ICS, mitre_attack_technique T0888; \
    sid:3700109; rev:1;)

alert s7comm any any -> any 102 (msg:"S7COMM-Plus CreateObject"; \
    s7comm.plus_function:0x04bb; \
    classtype:attempted-admin; \
    metadata:attack_target ICS, mitre_attack_technique T0843; \
    sid:3700110; rev:1;)


# ============================================================================
# Protocol anomalies & DoS (parser app-layer events)
# ATT&CK ICS: T0814 Denial of Service
# ----------------------------------------------------------------------------
# Structural/behavioral detections for oversized/malformed S7comm traffic where
# no exact exploit bytes are published. These consume the parser's own
# app-layer events rather than fixed byte offsets.

# Oversized / truncated / otherwise malformed S7comm PDU. Also trips when a PDU
# exceeds the parser's max-buffer guard (S7COMM_MAX_BUFFER, default 131072).
alert s7comm any any -> any 102 (msg:"S7COMM ANOMALY Malformed or oversized S7comm PDU"; \
    app-layer-event:s7comm.malformed_pdu; \
    classtype:protocol-command-decode; \
    metadata:attack_target ICS, mitre_attack_technique T0814; \
    sid:3700300; rev:1;)

# Transaction flood: the parser's live-transaction guard (max-tx, default 1024)
# tripped — more concurrent S7comm transactions than the configured cap.
alert s7comm any any -> any 102 (msg:"S7COMM DoS Transaction flood (max-tx guard tripped)"; \
    app-layer-event:s7comm.too_many_transactions; \
    classtype:attempted-dos; \
    metadata:attack_target ICS, mitre_attack_technique T0814; \
    sid:3700301; rev:1;)

# Invalid S7comm protocol identifier (0x32 expected) on port 102 — protocol
# confusion, tunnelling, or a malformed/oversized frame that desynced parsing.
alert s7comm any any -> any 102 (msg:"S7COMM ANOMALY Invalid protocol identifier"; \
    app-layer-event:s7comm.invalid_protocol_id; \
    classtype:protocol-command-decode; \
    metadata:attack_target ICS; \
    sid:3700302; rev:1;)
